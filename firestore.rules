rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "9mcytn2wLHhVBltjAwPq6P2A5dh1";
    }
    match /users/{userId}/{document=**} {
      allow read, write: if isAdmin() && userId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
